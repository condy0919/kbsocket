        ":sq_multiplex_test_support",
        "//kbsocket/base:no_destructor",
        "//kbsocket/transport/raw:urma_api",
        "//kbsocket/transport/raw:urma_test_support",
        "//tools/common:control_channel",
        "@googletest//:gtest_main",
    ],

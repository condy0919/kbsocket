load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

cc_library(
    name = "urma_api",
    srcs = ["urma_api.cpp"],
    hdrs = ["urma_api.hpp"],
    linkopts = ["-ldl"],
    visibility = ["//visibility:public"],
    deps = [
        "@urma//:urma_headers",
    ],
)

cc_library(
    name = "urma_test_support",
    testonly = True,
    hdrs = ["testing/scoped_urma_override.hpp"],
    visibility = ["//visibility:public"],
    deps = [":urma_api"],
)

cc_test(
    name = "urma_api_test",
    srcs = ["urma_api_test.cpp"],
    linkopts = [
        "-Wl,--wrap=dlopen",
        "-Wl,--wrap=dlsym",
        "-Wl,--wrap=dlclose",
        "-Wl,--wrap=dlerror",
    ],
    # --wrap 只在链接步骤替换符号引用，因此需将 urma_api 静态链接进去。如果没有
    # `linkstatic = True` 则会使用 liburma_api.so, 它内部的 ::dlopen() 等调用不
    # 会被 --wrap 拦截。这里不会静态链接 liburma.so, 只是要求静态链接 urma_api
    # 与 urma_test_support.
    linkstatic = True,
    deps = [
        ":urma_api",
        ":urma_test_support",
        "@googletest//:gtest_main",
    ],
)


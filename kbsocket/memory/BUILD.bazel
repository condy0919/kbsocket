    deps = [
        ":buffer_lease",
        ":quarantine_ledger",
        "//kbsocket/transport/raw:urma_api",
    ],
)

cc_library(
    name = "lease_return_queue",
    srcs = ["lease_return_queue.cpp"],
    hdrs = ["lease_return_queue.hpp"],
    visibility = ["//visibility:public"],
    deps = [":buffer_lease"],
)

cc_library(
    name = "lease_return_progress",
    srcs = ["lease_return_progress.cpp"],
    hdrs = ["lease_return_progress.hpp"],
    visibility = ["//visibility:public"],
    deps = [
        ":lease_return_queue",
        ":slab_allocator",
        "//kbsocket/runtime:progress_source",
    ],
)

cc_test(
    name = "slab_allocator_test",
    srcs = ["slab_allocator_test.cpp"],
    deps = [
        ":slab_allocator",
        "//kbsocket/transport/raw:urma_test_support",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "lease_return_queue_test",

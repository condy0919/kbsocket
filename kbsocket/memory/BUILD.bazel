load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

cc_library(
    name = "buffer_lease",
    hdrs = ["buffer_lease.hpp"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "quarantine_ledger",

    deps = [
        ":lease_return_queue",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "lease_return_progress_test",
    srcs = ["lease_return_progress_test.cpp"],
    deps = [
        ":lease_return_progress",
        ":lease_return_queue",
        ":slab_allocator",
        "//kbsocket/runtime:control_executor",
        "//kbsocket/runtime:shard_reactor",
        "//kbsocket/transport/raw:urma_test_support",
        "@googletest//:gtest_main",
    ],
